#!/usr/bin/env bash
# {{ ansible_managed }}
set -euo pipefail

cert_dir="/etc/letsencrypt/live/{{ nginx_cert_name }}"
install -d -m 0700 -o root -g root "{{ nginx_tls_dir }}"
install -m 0644 "${cert_dir}/fullchain.pem" "{{ nginx_tls_cert_path }}"
install -m 0600 "${cert_dir}/privkey.pem" "{{ nginx_tls_key_path }}"
restorecon -R "{{ nginx_tls_dir }}"

if systemctl is-active --quiet {{ nginx_service_name }}; then
  systemctl reload {{ nginx_service_name }}
fi

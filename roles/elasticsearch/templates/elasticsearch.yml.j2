# {{ ansible_managed }}
cluster.name: {{ elasticsearch_cluster_name }}
node.name: {{ elasticsearch_node_name }}
path.data: {{ elasticsearch_data_dir }}
path.logs: {{ elasticsearch_log_dir }}

network.host: {{ elasticsearch_network_host }}
http.port: {{ elasticsearch_http_port }}
transport.port: {{ elasticsearch_transport_port }}
discovery.type: single-node

bootstrap.memory_lock: false
action.destructive_requires_name: true
http.compression: true

xpack.security.enabled: true
xpack.security.enrollment.enabled: false
xpack.security.http.ssl.enabled: true
xpack.security.http.ssl.certificate: {{ elasticsearch_tls_cert_path }}
xpack.security.http.ssl.key: {{ elasticsearch_tls_key_path }}
xpack.security.http.ssl.certificate_authorities:
  - {{ elasticsearch_tls_ca_path }}
xpack.security.http.ssl.supported_protocols:
  - TLSv1.2
  - TLSv1.3
xpack.security.transport.ssl.enabled: true
xpack.security.transport.ssl.verification_mode: certificate
xpack.security.transport.ssl.certificate: {{ elasticsearch_tls_cert_path }}
xpack.security.transport.ssl.key: {{ elasticsearch_tls_key_path }}
xpack.security.transport.ssl.certificate_authorities:
  - {{ elasticsearch_tls_ca_path }}
xpack.security.transport.ssl.supported_protocols:
  - TLSv1.2
  - TLSv1.3
xpack.ml.enabled: false

s3.client.default.endpoint: "{{ elasticsearch_s3_endpoint }}"
s3.client.default.path_style_access: true
# Garage rejects the AWS SDK's default aws-chunked trailer signatures.
s3.client.default.disable_chunked_encoding: true
s3.client.default.region: {{ elasticsearch_s3_region }}

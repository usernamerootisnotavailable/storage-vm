# {{ ansible_managed }}
# TYPE      DATABASE  USER      ADDRESS       METHOD
local       all       postgres                peer
local       all       all                     peer

{% for app in postgresql_apps if app.state == 'present' %}
{% for database in app.databases %}
{% for cidr in app.cidrs %}
{{ 'hostssl' if postgresql_tls_enabled | bool else 'host' }}     {{ database }}  {{ app.user }}  {{ cidr }}  scram-sha-256
{% endfor %}
{% endfor %}
{% endfor %}

{% for provisioner in postgresql_provisioners if provisioner.state == 'present' %}
{% for cidr in provisioner.cidrs %}
hostssl     postgres  {{ provisioner.user }}  {{ cidr }}  scram-sha-256
{% endfor %}
{% endfor %}

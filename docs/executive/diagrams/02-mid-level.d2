# Storage Host — mid-level sequence
# Trust boundary, ports, protocols, and lifecycle triggers.
shape: sequence_diagram

classes: {
  client: {style: {fill: "#F0FDFA"; stroke: "#0F766E"; font-color: "#134E4A"; font-size: 34}}
  ctrl: {style: {fill: "#FFFFFF"; stroke: "#1D4ED8"; font-color: "#1E3A8A"; font-size: 34}}
  host: {style: {fill: "#F8FAFC"; stroke: "#1E293B"; font-color: "#0B1F33"; font-size: 34}}
  proxy: {style: {fill: "#0F766E"; stroke: "#0F766E"; font-color: "#FFFFFF"; font-size: 36; bold: true}}
  ext: {style: {fill: "#FFFBEB"; stroke: "#B45309"; font-color: "#78350F"; font-size: 34}}
  planned: {style: {fill: "#F8FAFC"; stroke: "#94A3B8"; stroke-dash: 4; font-color: "#475569"; font-size: 32}}
  deploy: {style: {stroke: "#1D4ED8"; stroke-width: 3; font-color: "#1D4ED8"; font-size: 30}}
  runtime: {style: {stroke: "#0F766E"; stroke-width: 3; font-color: "#0F766E"; font-size: 30}}
  cert: {style: {stroke: "#B45309"; stroke-width: 3; stroke-dash: 4; font-color: "#92400E"; font-size: 30}}
  snapshot: {style: {stroke: "#7C3AED"; stroke-width: 3; stroke-dash: 4; font-color: "#6D28D9"; font-size: 30}}
  plannededge: {style: {stroke: "#64748B"; stroke-width: 2; stroke-dash: 6; font-color: "#475569"; font-size: 30}}
}

clients: "Private clients\nprivate / VPN CIDRs" {class: client}
controller: "Controller / CI\nAnsible + SOPS/age" {class: ctrl}
edge: "storage01 · firewalld → NGINX :443\nhttpd_t · TLS 1.2 / 1.3" {class: proxy}
es: "Elasticsearch 9.5\n:9200 loopback HTTPS" {class: host}
garage: "Garage 2.5\n:3900 S3 · :3903 admin" {class: host}
db: "PostgreSQL 18 / MariaDB 11.8\n:5432 / :3306 TLS" {class: host}
cert: "Certbot 5.10\nrenewal timer" {class: host}
cloud: "Cloudflare + Let's Encrypt\nDNS-01" {class: ext}
backup: "Off-host backup\nplanned" {class: planned}

"Deploy & certify": {
  style: {font-size: 36}
  controller -> edge: "1  Ansible · SSH 22\nroles in dependency order" {class: deploy}
  cert -> cloud: "2  DNS-01 / ACME\nfirst deploy + 2x daily" {class: cert}
  cert -> edge: "2  deploy hook\nreload" {class: cert}
}

"Serve requests": {
  style: {font-size: 36}
  clients -> edge: "3  HTTPS 443\nprivate / VPN CIDRs only" {class: runtime}
  edge -> es: "3  HTTPS 9200\nCA verified · 401 passthrough" {class: runtime}
  edge -> garage: "3  HTTP 3900\nHost + path preserved" {class: runtime}
  clients -> db: "4  TLS 5432 / 3306\nloopback / opt-in CIDR" {class: plannededge}
}

"Protect & recover": {
  style: {font-size: 36}
  es -> garage: "5  S3 snapshots\non demand / scheduled" {class: snapshot}
  db -> backup: "6  off-host backup\nplanned daily" {class: plannededge}
}
